# Placement Twin Backend Environment Configuration
PORT=5000
NODE_ENV=production

# Cloud AI Inference (Recommended for Vercel/Render deployment)
# Get a free key at https://console.groq.com (takes 10 seconds, 100% free)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local Python FastAPI AI service (used if GROQ_API_KEY is not set)
AI_SERVICE_URL=http://127.0.0.1:8000

# Optional LiveAvatar API Key (for real-time streaming video avatar)
LIVEAVATAR_API_KEY=your_liveavatar_api_key_here
